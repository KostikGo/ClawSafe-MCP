# ClawSafe / clawsafe-mcp configuration
# Copy this file to ".env" or export the variables in your shell.

# Solana RPC endpoint used by the MCP server (mainnet-beta by default).
# Use a devnet endpoint for testing, e.g. https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Commitment level for reads and transaction confirmation:
# "processed" | "confirmed" | "finalized"
SOLANA_COMMITMENT=confirmed

# Parent directory of the .clawsafe data dir (default: ~).
# CLAWSAFE_HOME=/tmp/clawsafe-test
